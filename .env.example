# Apple Worm Adventure — local Docker development defaults
# START-AWA.ps1 replaces the three template secrets below on first startup.

VITE_GAME_NAME=APPLE WORM ADVENTURE
VITE_API_URL=http://localhost:8002/api
VITE_API_BASE_URL=/api

GAME_NAME=APPLE WORM ADVENTURE

# Keep your existing local secret value
DJANGO_SECRET_KEY=replace-with-a-unique-secret-generated-for-this-installation

# Disable Django debug pages
DJANGO_DEBUG=false

# Allow localhost, Docker backend and Android phone
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,192.168.1.9

POSTGRES_DB=veloop
POSTGRES_USER=veloop_user

# Keep your existing local database password
POSTGRES_PASSWORD=replace-with-a-strong-unique-database-password

AD_PROVIDER=provider_free_demo
ALLOW_PROVIDER_FREE_DEMO_ADS=true
PROVIDER_FREE_DEMO_DURATION_SECONDS=3

# Keep your existing local webhook secret
AD_PROVIDER_WEBHOOK_SECRET=replace-with-a-unique-webhook-secret

AD_PROVIDER_ADAPTER=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_VERIFICATION_REQUIRED=false

# Local PC and Android phone frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://192.168.1.9:5174

# Trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.9:5174

SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Local HTTP development: do not force HTTPS or enable HSTS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
