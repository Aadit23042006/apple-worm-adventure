# Apple Worm Adventure — production template. Copy to .env.production.
# Replace every CHANGE_ME value. Never commit or share .env.production.

VITE_GAME_NAME=APPLE WORM ADVENTURE
VITE_API_BASE_URL=/api
GAME_NAME=APPLE WORM ADVENTURE

# Public hostname must resolve to this Docker host; do not include scheme/path.
AWA_DOMAIN=CHANGE_ME_assigned-hostname.example.com
ACME_EMAIL=CHANGE_ME_valid-operations-email@example.com
FRONTEND_BASE_URL=https://CHANGE_ME_assigned-hostname.example.com

DJANGO_SECRET_KEY=CHANGE_ME_generate_with_PREPARE-PRODUCTION.ps1
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=CHANGE_ME_assigned-hostname.example.com

POSTGRES_DB=veloop
POSTGRES_USER=veloop_user
POSTGRES_PASSWORD=CHANGE_ME_generate_with_PREPARE-PRODUCTION.ps1

# Live rewarded ads stay blocked until an actual provider adapter is implemented,
# configured and its signed callback is tested. Never use a fake completion flag.
AD_PROVIDER=real
AD_PROVIDER_ADAPTER=CHANGE_ME_provider_module.YourProviderAdapter
ALLOW_PROVIDER_FREE_DEMO_ADS=false
AD_PROVIDER_WEBHOOK_SECRET=CHANGE_ME_configure_the_same_signing_secret_in_provider_dashboard

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=CHANGE_ME_smtp_host
EMAIL_PORT=587
EMAIL_HOST_USER=CHANGE_ME_smtp_username
EMAIL_HOST_PASSWORD=CHANGE_ME_smtp_password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_VERIFICATION_REQUIRED=true
DEFAULT_FROM_EMAIL=CHANGE_ME_no-reply@example.com

# Use exact HTTPS origins. No trailing slash.
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_assigned-hostname.example.com
CSRF_TRUSTED_ORIGINS=https://CHANGE_ME_assigned-hostname.example.com

# Caddy terminates TLS; Django trusts the forwarded HTTPS proto only in prod.
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_HTTPONLY=false
CSRF_COOKIE_SAMESITE=Lax
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SECURE_PROXY_SSL_HEADER_ENABLED=true
