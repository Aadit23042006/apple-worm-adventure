FROM node:22-alpine AS build

ARG VITE_GAME_NAME=APPLE WORM ADVENTURE
ARG VITE_API_BASE_URL=/api

ENV VITE_GAME_NAME=${VITE_GAME_NAME}
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

WORKDIR /app

COPY package*.json ./

RUN npm ci --include=optional
RUN npm install --no-save --package-lock=false @typescript/typescript-linux-x64@7.0.2 --include=optional
RUN npm install --no-save --package-lock=false @typescript/typescript-linux-x64@7.0.2

COPY . .

RUN npm run build


FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]